        "packages/core/src/market/backtest/*"
      ],
      "@dyna/indicators": [
        "packages/core/src/market/indicators/index.ts"
      ],
      "@dyna/indicators/*": [
        "packages/core/src/market/indicators/*"
      ],
      "@dyna/position-sizing": [
