{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "bun"
    ],
    "rootDir": ".",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@dyna/contracts": [
        "packages/core/src/types/index.ts"
      ],
      "@dyna/contracts/*": [
        "packages/core/src/types/*"
      ],
      "@dyna/event-bus": [
        "packages/core/src/events/index.ts"
      ],
      "@dyna/event-bus/*": [
        "packages/core/src/events/*"
      ],
      "@dyna/audit": [
        "packages/core/src/audit/index.ts"
      ],
      "@dyna/audit/*": [
        "packages/core/src/audit/*"
      ],
      "@dyna/risk-core": [
        "packages/core/src/risk/core/index.ts"
      ],
      "@dyna/risk-core/*": [
        "packages/core/src/risk/core/*"
      ],
      "@dyna/policy-engine": [
        "packages/core/src/risk/policy/index.ts"
      ],
      "@dyna/policy-engine/*": [
        "packages/core/src/risk/policy/*"
      ],
      "@dyna/exchange-ccxt": [
        "packages/core/src/market/exchange/index.ts"
      ],
