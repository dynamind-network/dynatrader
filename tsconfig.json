{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun"],
    "rootDir": ".",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@dyna/contracts": ["src/types/index.ts"],
      "@dyna/contracts/*": ["src/types/*"],
      "@dyna/event-bus": ["src/events/index.ts"],
      "@dyna/event-bus/*": ["src/events/*"],
      "@dyna/audit": ["src/audit/index.ts"],
      "@dyna/audit/*": ["src/audit/*"],
      "@dyna/risk-core": ["src/risk/core/index.ts"],
      "@dyna/risk-core/*": ["src/risk/core/*"],
      "@dyna/policy-engine": ["src/risk/policy/index.ts"],
      "@dyna/policy-engine/*": ["src/risk/policy/*"],
      "@dyna/exchange-ccxt": ["src/market/exchange/index.ts"],
      "@dyna/exchange-ccxt/*": ["src/market/exchange/*"],
      "@dyna/backtest": ["src/market/backtest/index.ts"],
      "@dyna/backtest/*": ["src/market/backtest/*"],
      "@dyna/indicators": ["src/market/indicators/index.ts"],
      "@dyna/indicators/*": ["src/market/indicators/*"],
      "@dyna/position-sizing": ["src/market/sizing/index.ts"],
      "@dyna/position-sizing/*": ["src/market/sizing/*"],
      "@dyna/scanner": ["src/market/scanner/index.ts"],
      "@dyna/scanner/*": ["src/market/scanner/*"],
      "@dyna/memory-core": ["src/memory/core/index.ts"],
      "@dyna/memory-core/*": ["src/memory/core/*"],
      "@dyna/memory-runtime": ["src/memory/runtime/index.ts"],
      "@dyna/memory-runtime/*": ["src/memory/runtime/*"],
      "@dyna/agent-core": ["src/agent/core/index.ts"],
      "@dyna/agent-core/*": ["src/agent/core/*"],
      "@dyna/agent-cron": ["src/agent/cron/index.ts"],
      "@dyna/agent-cron/*": ["src/agent/cron/*"],
      "@dyna/memory-sqlite": ["src/memory/sqlite/index.ts"],
      "@dyna/memory-sqlite/*": ["src/memory/sqlite/*"],
      "@dyna/multiagent": ["src/agent/multi/index.ts"],
      "@dyna/multiagent/*": ["src/agent/multi/*"],
      "@dyna/bot-templates": ["src/agent/templates/index.ts"],
      "@dyna/bot-templates/*": ["src/agent/templates/*"],
      "@dyna/tools-runtime": ["src/runtime/tools/index.ts"],
      "@dyna/tools-runtime/*": ["src/runtime/tools/*"],
      "@dyna/plugin-runtime": ["src/runtime/plugins/index.ts"],
      "@dyna/plugin-runtime/*": ["src/runtime/plugins/*"],
      "@dyna/skill-runtime": ["src/runtime/skills/index.ts"],
      "@dyna/skill-runtime/*": ["src/runtime/skills/*"],
      "@dyna/subagent-runtime": ["src/runtime/subagents/index.ts"],
      "@dyna/subagent-runtime/*": ["src/runtime/subagents/*"],
      "@dyna/mcp-runtime": ["src/runtime/mcp/index.ts"],
      "@dyna/mcp-runtime/*": ["src/runtime/mcp/*"],
      "@dyna/webhook-runtime": ["src/runtime/webhooks/index.ts"],
      "@dyna/webhook-runtime/*": ["src/runtime/webhooks/*"],
      "@dyna/notification-runtime": ["src/runtime/notifications/index.ts"],
      "@dyna/notification-runtime/*": ["src/runtime/notifications/*"],
      "@dyna/command-router": ["src/runtime/commands/index.ts"],
      "@dyna/command-router/*": ["src/runtime/commands/*"],
      "@dyna/channel-runtime": ["src/runtime/channels/index.ts"],
      "@dyna/channel-runtime/*": ["src/runtime/channels/*"],
      "@dyna/auth-runtime": ["src/governance/auth/index.ts"],
      "@dyna/auth-runtime/*": ["src/governance/auth/*"],
      "@dyna/permission-runtime": ["src/governance/permissions/index.ts"],
      "@dyna/permission-runtime/*": ["src/governance/permissions/*"],
      "@dyna/approval-engine": ["src/governance/approval/index.ts"],
      "@dyna/approval-engine/*": ["src/governance/approval/*"],
      "@dyna/run-cards": ["src/governance/run-cards/index.ts"],
      "@dyna/run-cards/*": ["src/governance/run-cards/*"],
      "@dyna/gateway": ["src/gateway/core/index.ts"],
      "@dyna/gateway/*": ["src/gateway/core/*"],
      "@dyna/channels-core": ["src/gateway/channels/index.ts"],
      "@dyna/channels-core/*": ["src/gateway/channels/*"],
      "@dyna/telegram-gateway": ["src/gateway/telegram/index.ts"],
      "@dyna/telegram-gateway/*": ["src/gateway/telegram/*"],
      "@dyna/context-compressor": ["src/context/index.ts"],
      "@dyna/context-compressor/*": ["src/context/*"],
      "@dyna/observability": ["src/monitoring/observability/index.ts"],
      "@dyna/observability/*": ["src/monitoring/observability/*"],
      "@dyna/performance-core": ["src/monitoring/performance/index.ts"],
      "@dyna/performance-core/*": ["src/monitoring/performance/*"],
      "@dyna/security-boundary": ["src/monitoring/security/index.ts"],
      "@dyna/security-boundary/*": ["src/monitoring/security/*"],
      "@dyna/orchestration/workspace": ["src/orchestration/workspace/index.ts"],
      "@dyna/orchestration/workspace/*": ["src/orchestration/workspace/*"],
      "@dyna/types": ["src/types/index.ts"],
      "@dyna/types/*": ["src/types/*"],
      "@dyna/strategy-ir": ["src/agent/strategy/index.ts"],
      "@dyna/strategy-ir/*": ["src/agent/strategy/*"],
      "@dyna/workspace": ["src/orchestration/workspace/index.ts"],
      "@dyna/workspace/*": ["src/orchestration/workspace/*"],
      "@dyna/manifest-loader": ["src/orchestration/manifest/index.ts"],
      "@dyna/manifest-loader/*": ["src/orchestration/manifest/*"],
      "@dyna/model-router": ["src/orchestration/models/index.ts"],
      "@dyna/model-router/*": ["src/orchestration/models/*"],
      "@dyna/interactive-prompts": ["src/orchestration/interactive/index.ts"],
      "@dyna/interactive-prompts/*": ["src/orchestration/interactive/*"],
      "@dyna/a2a-runtime": ["src/orchestration/a2a/index.ts"],
      "@dyna/a2a-runtime/*": ["src/orchestration/a2a/*"],
      "@dyna/trpc": ["src/orchestration/trpc/index.ts"],
      "@dyna/trpc/*": ["src/orchestration/trpc/*"],
      "@dyna/execution": ["src/runtime/execution/index.ts"],
      "@dyna/execution/*": ["src/runtime/execution/*"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "ui"
  ]
}
