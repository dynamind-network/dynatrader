# ============================================================================
# DynaTrader Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# API keys can also be set as shell environment variables.
# ============================================================================

# --- LLM Provider (choose one or more) ---

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=           # Alternative name for Google/Gemini

# --- Local Models (no API key needed) ---

OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_MODEL=

# --- Exchange API Keys ---

# Binance
BINANCE_API_KEY=
BINANCE_SECRET=

# Coinbase
COINBASE_API_KEY=
COINBASE_SECRET=
COINBASE_PASSPHRASE=

# Kraken
KRAKEN_API_KEY=
KRAKEN_SECRET=

# OKX
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# Bybit
BYBIT_API_KEY=
BYBIT_SECRET=

# Generic (works with any CCXT exchange)
EXCHANGE_ID=
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
EXCHANGE_PASSPHRASE=

# --- Gateway (optional) ---

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# --- Runtime Overrides ---

DYNA_WORKSPACE=           # Override workspace path (default: ~/.dynatrader)
DYNA_MODE=paper           # research | backtest | paper | shadow | micro_live | live
DYNATRADER_MODEL=         # Override model provider
DYNATRADER_ENTRY=         # Override stdio entry point

# --- Development ---

DYNATRADER_DEV=           # Set to "true" for development mode
DYNATRADER_ONESHOT=       # Set to "true" for non-interactive mode
DYNATRADER_PROMPT=        # Prompt to send in oneshot mode
DYNATRADER_SESSION=       # Session ID for resuming conversations
DYNA_SHOW_THINKING=true   # Show model reasoning in TUI
