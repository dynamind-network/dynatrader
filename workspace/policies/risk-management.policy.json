{
  "name": "Risk Management Policy",
  "version": "1.0.0",
  "description": "Comprehensive risk management framework for trading activities",
  "rules": [
    {
      "name": "Maximum Position Size",
      "condition": "position_size > max_exposure",
      "action": "deny",
      "auditLevel": "high"
    },
    {
      "name": "Daily Loss Limit",
      "condition": "daily_pnl < -daily_loss_limit",
      "action": "require_approval",
      "requiredApprovals": ["risk_manager"],
      "auditLevel": "critical"
    },
    {
      "name": "Strategy Risk Assessment",
      "condition": "strategy_volatility > high_risk_threshold",
      "action": "require_approval",
      "requiredApprovals": ["risk_manager"],
      "auditLevel": "high"
    },
    {
      "name": "Market Circuit Breaker",
      "condition": "price_change_percent > circuit_breaker_threshold",
      "action": "deny",
      "auditLevel": "critical"
    },
    {
      "name": "Liquidity Check",
      "condition": "market_liquidity < minimum_liquidity",
      "action": "deny",
      "auditLevel": "medium"
    },
    {
      "name": "Portfolio Concentration",
      "condition": "single_position_exposure > concentration_limit",
      "action": "require_approval",
      "requiredApprovals": ["risk_manager"],
      "auditLevel": "high"
    },
    {
      "name": "Correlation Risk",
      "condition": "portfolio_correlation > correlation_limit",
      "action": "require_approval",
      "requiredApprovals": ["risk_manager"],
      "auditLevel": "medium"
    },
    {
      "name": "Leverage Limit",
      "condition": "account_leverage > max_leverage",
      "action": "deny",
      "auditLevel": "high"
    },
    {
      "name": "Trading Hours Restriction",
      "condition": "current_time < market_open || current_time > market_close",
      "action": "deny",
      "auditLevel": "low"
    },
    {
      "name": "New Strategy Validation",
      "condition": "strategy_backtest_sharpe < minimum_sharpe",
      "action": "require_approval",
      "requiredApprovals": ["risk_manager", "trader"],
      "auditLevel": "medium"
    }
  ]
}