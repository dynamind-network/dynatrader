{
  "name": "@dynatrader/ink",
  "version": "5.2.1-dyna.0",
  "description": "Ink renderer fork with terminal-grid text selection for DynaTrader",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./terminal": { "types": "./dist/terminal.d.ts", "import": "./dist/terminal.js" },
    "./selection": { "types": "./dist/terminal-selection.d.ts", "import": "./dist/terminal-selection.js" }
  },
  "files": ["dist/**/*", "LICENSE", "README.md", "UPSTREAM-README.md"],
  "scripts": { "build": "tsc -p tsconfig.json && node scripts/build-terminal.mjs", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "vitest run --config vitest.config.ts" },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.1.3",
    "ansi-escapes": "^7.0.0",
    "ansi-styles": "^6.2.1",
    "auto-bind": "^5.0.1",
    "chalk": "^5.3.0",
    "cli-boxes": "^3.0.0",
    "cli-cursor": "^4.0.0",
    "cli-truncate": "^4.0.0",
    "code-excerpt": "^4.0.0",
    "es-toolkit": "^1.22.0",
    "indent-string": "^5.0.0",
    "is-in-ci": "^1.0.0",
    "patch-console": "^2.0.0",
    "react-reconciler": "^0.29.0",
    "scheduler": "^0.23.0",
    "signal-exit": "^3.0.7",
    "slice-ansi": "^7.1.0",
    "stack-utils": "^2.0.6",
    "string-width": "^7.2.0",
    "widest-line": "^5.0.0",
    "wrap-ansi": "^9.0.0",
    "ws": "^8.18.0",
    "yoga-layout": "~3.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-reconciler": "^0.28.9",
    "@types/signal-exit": "^3.0.2",
    "@types/stack-utils": "^2.0.3",
    "type-fest": "^4.27.0",
    "typescript": "^5.4.0",
    "vitest": "^3.1.0"
  },
  "peerDependencies": { "@types/react": ">=18.0.0", "react": ">=18.0.0" },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/dynamind-network/dynatrader.git", "directory": "packages/ink" },
  "publishConfig": { "access": "public" }
}
