{
  "name": "dynatrader",
  "version": "3.0.0",
  "description": "Open-source trading and DeFi AI agent runtime with integrated terminal UI",
  "type": "module",
  "workspaces": ["ui", "packages/*"],
  "bin": {
    "dynatrader": "./dist/entry/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "default": "./dist/kernel.js"
    }
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:plugins": "bun run --filter '@dyna/plugin-*' build",
    "build:ui": "node -e \"const fs = require('node:fs'); fs.rmSync('ui/dist', { recursive: true, force: true }); fs.rmSync('ui/tsconfig.tsbuildinfo', { force: true })\" && cd ui && bun run build",
    "build:all": "bun run build && bun run build:plugins && bun run build:ui && node scripts/release/stage-ui.mjs",
    "build:release": "bun run build && bun run build:ui && node scripts/release/stage-ui.mjs",
    "dev": "bun run build && node dist/entry/cli.js",
    "start": "node dist/entry/cli.js",
    "gateway": "node dist/entry/cli.js --stdio",
    "release:package-smoke": "node scripts/release/package-smoke.mjs",
    "release:check": "bun run build:release && bun run typecheck && bun run typecheck:ui && node node_modules/vitest/vitest.mjs run --reporter=dot && cd ui && bun run test && cd .. && bun run release:package-smoke",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "bun run evals/benchmark-matrix.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "cd ui && bun run typecheck",
    "clean": "rm -rf dist .tsbuildinfo",
    "context:bench": "bun run src/context/benchmark/run.ts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": ["trading", "algorithmic", "typescript", "agent", "llm", "terminal", "tui"],
  "author": "DynaTrader Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dynamind-network/dynatrader.git"
  },
  "bugs": {
    "url": "https://github.com/dynamind-network/dynatrader/issues"
  },
  "homepage": "https://github.com/dynamind-network/dynatrader#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "catalog": {
    "typescript": "^5.4.0",
    "tsup": "8.5.1"
  },
  "packageManager": "bun@1.0.0",
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/bun": "latest",
    "@types/better-sqlite3": "7.6.13",
    "@types/crypto-js": "4.2.2",
    "@types/express": "5.0.6",
    "@types/js-yaml": "4.0.9",
    "@types/jsonwebtoken": "9.0.10",
    "@types/ms": "2.1.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "9.0.8",
    "tsup": "8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@msgpack/msgpack": "^3.1.2",
    "@trpc/server": "11.18.0",
    "@uniswap/sdk-core": "7.18.0",
    "@uniswap/smart-order-router": "4.31.10",
    "@uniswap/v2-sdk": "4.21.0",
    "@uniswap/v3-sdk": "3.31.0",
    "asciichart": "^1.5.25",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "12.11.1",
    "ccxt": "^4.3.48",
    "cheerio": "^1.2.0",
    "conf": "^15.1.0",
    "crypto-js": "^4.1.1",
    "discord.js": "14.26.4",
    "emittery": "^1.0.1",
    "ethers": "^6.9.0",
    "express": "^4.22.0",
    "fdir": "^6.4.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "9.0.3",
    "log-update": "^7.2.0",
    "marked": "^18.0.9",
    "openai": "^7.4.0",
    "pako": "^2.1.0",
    "pdf-parse": "^2.4.5",
    "picomatch": "^4.0.4",
    "playwright": "1.61.1",
    "react": "^18.3.0",
    "simple-git": "^3.32.3",
    "technicalindicators": "3.1.0",
    "tiktoken": "^1.0.0",
    "uuid": "^11.0.0",
    "viem": "2.55.0",
    "winston": "^3.10.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.0"
  }
}
